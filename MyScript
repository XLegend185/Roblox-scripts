local function IsAlive(plr)
    local ch = plr.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health and hum.Health > 0
end

local function GetRoot(plr)
    if not plr.Character then return nil end
    return plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")
end

local function GetHead(plr)
    if not plr.Character then return nil end
    return plr.Character:FindFirstChild("Head")
end

local function TableCopy(t)
    local r = {}
    for k,v in pairs(t) do r[k]=v end
    return r
end

