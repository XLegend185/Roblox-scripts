-- TimeStop (client-side)
-----------------------
local TimeSaved = {}
local function ApplyTimeStop()
    TimeSaved = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and p.Character then
            TimeSaved[p] = {}
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    TimeSaved[p][part] = {Anchored = part.Anchored, CanCollide = part.CanCollide}
                    pcall(function() part.Anchored = true; part.CanCollide = false end)
                end
            end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum then TimeSaved[p].WalkSpeed = hum.WalkSpeed; pcall(function() hum.WalkSpeed = 0 end) end
        end
    end
end

local function RemoveTimeStop()
    for p, tbl in pairs(TimeSaved) do
        if p.Character then
            for part, st in pairs(tbl) do
                if part and part.Parent then
                    pcall(function() part.Anchored = st.Anchored; part.CanCollide = st.CanCollide end)
                end
            end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and tbl.WalkSpeed then pcall(function() hum.WalkSpeed = tbl.WalkSpeed end) end
        end
    end
    TimeSaved = {}
end

-----------------------
-- Invisibility
-----------------------
local InvisSaved = {}
local function ApplyInvis()
    local ch = LocalPlayer.Character
    if not ch then return end
    InvisSaved = {}
    for _, obj in ipairs(ch:GetDescendants()) do
        if obj:IsA("BasePart") then
            InvisSaved[obj] = {Transparency = obj.Transparency, CanCollide = obj.CanCollide}
            pcall(function() obj.Transparency = 1; obj.CanCollide = false end)
        elseif obj:IsA("Decal") then
            InvisSaved[obj] = {Transparency = obj.Transparency}
            pcall(function() obj.Transparency = 1 end)
        end
    end
end

local function RemoveInvis()
    for obj, st in pairs(InvisSaved) do
        if obj and obj.Parent then
            pcall(function()
                if st.Transparency then obj.Transparency = st.Transparency end
                if st.CanCollide ~= nil then obj.CanCollide = st.CanCollide end
            end)
        end
    end
    InvisSaved = {}
end

-----------------------
-- Attack loops: TriggerBot / KillAura / SilentAim attempt
-----------------------
local function GetPartPosition(plr)
    local part = (STATE.AimbotTargetPart == "Head") and GetHead(plr) or GetRoot(plr)
    if part then return part.Position end
    return nil
end

local function InAimbotFOV(plr)
    local pos = GetPartPosition(plr)
    if not pos then return false end
    local ok, screenPos = pcall(function() return Camera:WorldToViewportPoint(pos) end)
    if not ok or not screenPos then return false end
    if screenPos.Z <= 0 then return false end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
    return dist <= STATE.AimbotFOV
end

-- AutoAttack routine (generic): tries remotes fallback to tool activation
local function TryAttackTarget(plr)
    if not plr or not IsAlive(plr) then return end

    -- Game-specific remotes should be added here for reliability.
    -- Example (uncomment and set correct Remote): pcall(function() workspace.Remotes.Attack:FireServer(plr) end)

    -- Fallback: if local tool exists, activate it
    SendAttackRemote()
end

-----------------------
-- Main RenderStepped: aimbot movement + fly control + tracers + attack checks
-----------------------
RunService.RenderStepped:Connect(function(dt)
    -- Aimbot: rotate camera toward target
    if STATE.Aimbot and (not STATE.AimbotHoldToAim or RMBDown) then
        local target = GetNearestVisibleTarget()
        if target and IsAlive(target) then
            lastAimTarget = target
            local part = (STATE.AimbotTargetPart == "Head") and GetHead(target) or GetRoot(target)
            if part then
                local aimPos = part.Position
                local camPos = Camera.CFrame.Position
                local desired = CFrame.new(camPos, aimPos)
                Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(1 - STATE.AimbotSmooth, 0.01, 1))
            end
        end
    end

    -- TriggerBot: if crosshair near head/root -> attack
    if STATE.TriggerBot then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsAlive(p) and InAimbotFOV(p) then
                -- visibility check
                local pos = GetPartPosition(p)
                if pos then
                    local origin = Camera.CFrame.Position
                    local dir = (pos - origin)
                    local hit = workspace:FindPartOnRayWithIgnoreList(Ray.new(origin, dir.Unit * dir.Magnitude), {LocalPlayer.Character, p.Character})
                    local visible = (not hit) or hit:IsDescendantOf(p.Character)
                    if visible then
                        TryAttackTarget(p)
                        break
                    end
                end
            end
        end
    end

    -- KillAura: attack nearby players automatically
    if STATE.KillAura then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsAlive(p) and GetRoot(p) then
                local myroot = GetRoot(LocalPlayer)
                local prot = GetRoot(p)
                if myroot and prot then
                    local dist = (myroot.Position - prot.Position).Magnitude
                    if dist <= STATE.KillAuraRadius then
                        TryAttackTarget(p)
                    end
                end
            end
        end
    end

    -- Fly movement
    if STATE.Fly and flyBV and GetRoot(LocalPlayer) then
        local hrp = GetRoot(LocalPlayer)
        local dir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then dir = dir.Unit end
        flyBV.Velocity = dir * STATE.FlySpeed
    end

    -- Tracers update
    if STATE.Tracers and DrawingAvailable then
        for plr, line in pairs(TracerTable) do
            if IsAlive(plr) and plr.Character then
                local part = GetRoot(plr) or GetHead(plr)
                if part then
                    local ok, v = pcall(function() return Camera:WorldToViewportPoint(part.Position) end)
                    if ok and v and v.Z>0 then
                        line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(v.X, v.Y)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                end
            else
                if TracerTable[plr] then RemoveTracer(plr) end
            end
        end
    end
end)

