-----------------------
-- Aimbot / Targeting
-----------------------
local function WorldToScreenPoint(pos)
    local ok, v = pcall(function() return Camera:WorldToViewportPoint(pos) end)
    if not ok or not v then return false, Vector2.new(0,0), 0 end
    return v.Z>0, Vector2.new(v.X, v.Y), v.Z
end

local function GetNearestVisibleTarget()
    local best, bestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local part = (STATE.AimbotTargetPart == "Head") and GetHead(plr) or GetRoot(plr)
            if part then
                local onScreen, screenPos, depth = WorldToScreenPoint(part.Position)
                if onScreen then
                    local dist = (screenPos - center).Magnitude
                    if dist < bestDist and dist <= STATE.AimbotFOV then
                        -- simple visibility check via raycast from camera to part
                        local origin = Camera.CFrame.Position
                        local direction = (part.Position - origin)
                        local ray = Ray.new(origin, direction.Unit * math.min(direction.Magnitude, 500))
                        local hit, hitpos = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, part.Parent})
                        local visible = (not hit) or (hit and hit:IsDescendantOf(part.Parent))
                        if visible then
                            bestDist = dist
                            best = plr
                        end
                    end
                end
            end
        end
    end
    return best
end

