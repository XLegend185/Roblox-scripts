local function FlingTarget(plr)
    if not plr or not IsAlive(plr) then return end
    local myHRP = GetRoot(LocalPlayer)
    local targetHRP = GetRoot(plr)
    if not myHRP or not targetHRP then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6,1e6,1e6)
    bv.P = 1250
    bv.Velocity = (targetHRP.Position - myHRP.Position).Unit * STATE.FlingPower + Vector3.new(0,120,0)
    bv.Parent = myHRP
    Debris:AddItem(bv, 0.35)
end

