local function CreateESPForPlayer(plr)
    if ESPTable[plr] then return end
    if not IsAlive(plr) then return end
    local head = GetHead(plr)
    if not head then return end

    local bg = Instance.new("BillboardGui")
    bg.Name = "LegendX_ESP"
    bg.Adornee = head
    bg.Size = UDim2.new(0,160,0,40)
    bg.StudsOffset = Vector3.new(0,2,0)
    bg.AlwaysOnTop = true
    bg.MaxDistance = 10000

    local label = Instance.new("TextLabel", bg)
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = plr.Name
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 14
    label.TextColor3 = Color3.new(1,1,1)
    label.TextStrokeTransparency = 0
    label.TextWrapped = true

    bg.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
    ESPTable[plr] = bg
end

local function RemoveESPForPlayer(plr)
    if ESPTable[plr] and ESPTable[plr].Parent then
        pcall(function() ESPTable[plr]:Destroy() end)
    end
    ESPTable[plr] = nil
end

local function RefreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and STATE.ESP and IsAlive(p) then
            if not ESPTable[p] then CreateESPForPlayer(p) end
        else
            RemoveESPForPlayer(p)
        end
    end
end

