-- Heartbeat housekeeping: ESP/Tracers/Highlight management
-----------------------
RunService.Heartbeat:Connect(function()
    -- ESP refresh
    RefreshAllESP()

    -- Tracer creation/removal
    if STATE.Tracers and DrawingAvailable then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and IsAlive(plr) and not TracerTable[plr] then CreateTracer(plr) end
            if (not IsAlive(plr)) and TracerTable[plr] then RemoveTracer(plr) end
        end
    else
        for p,_ in pairs(TracerTable) do RemoveTracer(p) end
    end

    -- Highlight
    if STATE.Highlight then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsAlive(p) and not HighlightTable[p] then CreateHighlight(p) end
            if (not IsAlive(p)) and HighlightTable[p] then RemoveHighlight(p) end
        end
    else
        for p,_ in pairs(HighlightTable) do RemoveHighlight(p) end
    end
end)

